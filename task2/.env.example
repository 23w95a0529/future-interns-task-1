# Copy this file to .env and adjust values before running the server

# Port the Express server listens on
PORT=4000

# Secret used to sign admin JWT tokens - change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Default admin account created automatically the first time the server runs
# (only used if data/db.json does not already exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
